# ── Nebula API — environment variables ──────────────────────────────────────
# Copy real values into your LOCAL .env (never commit it) and into the Railway
# dashboard (Variables tab) for production. PORT is injected by Railway — do NOT set it there.

# Runtime
NODE_ENV=production
PORT=5001                      # local only; Railway sets this automatically
LOG_LEVEL=info

# Database (Neon → "Connection string", use the POOLED one)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Encryption key for stored email config + activation tokens.
# KEEP THIS CONSTANT once set — changing it makes previously stored data unreadable.
EMAIL_SECRET_KEY=change-me-to-a-long-random-string

# Central transactional e-mail (Gmail app-password for durand2511@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=durand2511@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=durand2511@gmail.com

# Stripe (test keys now; swap for live keys when you go live)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI (chat builder + SEO + e-mail copy)
ANTHROPIC_API_KEY=sk-ant-...
# (optional alternative gateway)
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# Public URLs + custom-domain hosting
PUBLIC_APP_URL=https://nebulabookings.com
PUBLIC_API_URL=https://nebulabookings.com
PLATFORM_HOST=nebulabookings.com
CUSTOMERS_TARGET=customers.nebulabookings.com
